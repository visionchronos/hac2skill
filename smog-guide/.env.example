# SmogGuide environment configuration.
# Copy this file to .env and fill in real values. Never commit .env to version control.

# Application environment: development | production | test
SMOGGUIDE_APP_ENV=development

# Log level passed to Python's logging module (DEBUG, INFO, WARNING, ERROR, CRITICAL).
SMOGGUIDE_LOG_LEVEL=INFO

# LLM provider to use for rewriting advice text: none | gemini | anthropic
# When set to "none" the app runs fully with template-based fallback text.
SMOGGUIDE_LLM_PROVIDER=none

# API key for the chosen LLM provider. Leave blank when SMOGGUIDE_LLM_PROVIDER=none.
# SMOGGUIDE_LLM_API_KEY=your-api-key-here

# Maximum seconds to wait for an LLM response before timing out.
SMOGGUIDE_LLM_TIMEOUT_SECONDS=15.0

# Maximum tokens to request from the LLM for each advice response.
SMOGGUIDE_LLM_MAX_TOKENS=1200

# Maximum seconds to wait for an outbound HTTP call (AQI data, geocoding).
SMOGGUIDE_HTTP_TIMEOUT_SECONDS=8.0

# Maximum number of retries for a failed outbound HTTP call.
SMOGGUIDE_HTTP_MAX_RETRIES=2

# Seconds to cache air quality readings before re-fetching (default: 15 minutes).
SMOGGUIDE_AIR_QUALITY_CACHE_TTL_SECONDS=900

# Seconds to cache geocoding results before re-fetching (default: 24 hours).
SMOGGUIDE_GEOCODING_CACHE_TTL_SECONDS=86400

# Maximum number of entries to hold in any in-process cache.
SMOGGUIDE_CACHE_MAX_ENTRIES=512

# Comma-separated list of allowed CORS origins. Empty allows none.
SMOGGUIDE_CORS_ALLOWED_ORIGINS=

# Maximum API requests per IP per minute.
SMOGGUIDE_RATE_LIMIT_PER_MINUTE=20

# Maximum accepted request body size in bytes.
SMOGGUIDE_MAX_REQUEST_BODY_BYTES=16384

# Path to the recommendations YAML catalog, relative to the working directory.
SMOGGUIDE_CATALOG_PATH=data/recommendations.yaml

# Directory that contains the static frontend files.
SMOGGUIDE_STATIC_DIR=static
